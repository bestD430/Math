<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>小學數學冒險王 - 新思維版</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600&family=Noto+Sans+TC:wght@400;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Noto Sans TC', 'Fredoka', sans-serif;
            background: linear-gradient(135deg, #ffe6f0 0%, #e6f2ff 100%);
            min-height: 100vh;
        }
        .bouncy {
            animation: bounce 2s infinite;
        }
        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-8px); }
        }
        .pulse-btn {
            transition: all 0.2s ease;
        }
        .pulse-btn:hover {
            transform: scale(1.05);
        }
        .pulse-btn:active {
            transform: scale(0.95);
        }
    </style>
</head>
<body class="text-slate-700 flex flex-col items-center justify-start p-3 sm:p-6 box-border">

    <!-- 主容器：確保在手機直式下不超出邊界，並具備彈性寬度 -->
    <div id="app" class="w-full max-w-md bg-white/90 backdrop-blur-md rounded-3xl shadow-2xl p-5 border-4 border-pink-200 flex flex-col box-border">
        
        <!-- 頂部列：回首頁、難度、金幣/星星 -->
        <div id="top-bar" class="flex justify-between items-center mb-4 pb-3 border-b-2 border-pink-100 hidden">
            <button onclick="goHome()" class="bg-pink-100 hover:bg-pink-200 text-pink-600 font-bold px-3 py-1.5 rounded-full text-sm flex items-center gap-1 pulse-btn shadow-sm">
                🏠 回首頁
            </button>
            <div class="flex items-center gap-2">
                <span id="display-diff" class="bg-purple-100 text-purple-600 text-xs font-bold px-2.5 py-1 rounded-full">⭐ 難度 Lv.1</span>
                <span class="bg-amber-100 text-amber-700 text-xs font-bold px-2.5 py-1 rounded-full flex items-center gap-1">⭐ <span id="star-count">0</span></span>
                <span class="bg-slate-100 text-slate-700 text-xs font-bold px-2.5 py-1 rounded-full flex items-center gap-1">🪙 <span id="coin-count">0</span></span>
            </div>
        </div>

        <!-- 畫面 1：首頁選單 -->
        <div id="screen-home" class="flex flex-col items-center">
            <div class="text-center mb-4">
                <div class="text-5xl mb-2 bouncy">🦉✨</div>
                <h1 class="text-2xl font-black text-pink-500 tracking-wide">小學數學冒險王</h1>
                <p class="text-xs text-slate-400 mt-1">配合教育出版社《小學數學新思維》</p>
            </div>

            <!-- 吉祥物小Q對話框 -->
            <div class="w-full bg-pink-50 border-2 border-pink-200 rounded-2xl p-3 mb-4 text-xs text-pink-700 flex items-center gap-3 shadow-sm">
                <div class="text-2xl">🐱</div>
                <div><span class="font-bold">小Q：</span>嗨！今天想挑戰哪一個有趣的數學新思維單元呢？快來收集金幣幫我換裝吧！</div>
            </div>

            <!-- 選單按鈕區 -->
            <div class="w-full flex flex-col gap-2.5 mb-4">
                <button onclick="openGradeSelect()" class="w-full bg-gradient-to-r from-pink-400 to-rose-400 hover:from-pink-500 hover:to-rose-500 text-white font-bold py-3 px-4 rounded-2xl shadow-md pulse-btn text-base flex items-center justify-between">
                    <span>🚀 開始闖關練習</span>
                    <span class="text-lg">➔</span>
                </button>
                <button onclick="openSettings()" class="w-full bg-gradient-to-r from-purple-400 to-indigo-400 hover:from-purple-500 hover:to-indigo-500 text-white font-bold py-3 px-4 rounded-2xl shadow-md pulse-btn text-base flex items-center justify-between">
                    <span>⚙️ 遊戲與題數設定</span>
                    <span class="text-lg">⚙️</span>
                </button>
                <button onclick="openShop()" class="w-full bg-gradient-to-r from-amber-400 to-orange-400 hover:from-amber-500 hover:to-orange-500 text-white font-bold py-3 px-4 rounded-2xl shadow-md pulse-btn text-base flex items-center justify-between">
                    <span>👑 寵物換裝商店</span>
                    <span class="text-lg">🎁</span>
                </button>
            </div>
        </div>

        <!-- 畫面 2：年級與單元選擇 -->
        <div id="screen-grade" class="flex flex-col items-center hidden">
            <h2 class="text-lg font-bold text-pink-500 mb-3">📚 選擇學習年級與單元</h2>
            
            <!-- 年級切換 Tabs -->
            <div class="flex w-full bg-pink-50 p-1 rounded-2xl mb-3">
                <button onclick="switchGradeTab(1)" id="tab-g1" class="flex-1 py-1.5 text-xs font-bold rounded-xl bg-white text-pink-600 shadow-sm transition">一年級</button>
                <button onclick="switchGradeTab(2)" id="tab-g2" class="flex-1 py-1.5 text-xs font-bold rounded-xl text-slate-500 transition">二年級</button>
                <button onclick="switchGradeTab(3)" id="tab-g3" class="flex-1 py-1.5 text-xs font-bold rounded-xl text-slate-500 transition">三年級</button>
            </div>

            <!-- 單元清單容器 -->
            <div id="unit-list" class="w-full flex flex-col gap-2.5 max-h-72 overflow-y-auto pr-1">
                <!-- 動態生成單元按鈕 -->
            </div>

            <button onclick="goHome()" class="w-full mt-4 bg-slate-200 hover:bg-slate-300 text-slate-600 font-bold py-2.5 rounded-xl text-sm pulse-btn">
                返回主選單
            </button>
        </div>

        <!-- 畫面 3：設定選單 (題數 5~50, 難度 1~10) -->
        <div id="screen-settings" class="flex flex-col items-center hidden">
            <h2 class="text-lg font-bold text-purple-600 mb-3">⚙️ 遊戲參數設定</h2>
            
            <div class="w-full bg-purple-50/60 border-2 border-purple-100 rounded-2xl p-4 flex flex-col gap-4 mb-4 text-sm">
                <!-- 題數設定 -->
                <div>
                    <label class="block font-bold text-purple-700 mb-1 flex justify-from items-center justify-between">
                        <span>📝 每局練習題數：</span>
                        <span id="lbl-qcount" class="bg-purple-200 text-purple-800 px-2 py-0.5 rounded-md text-xs">10 題</span>
                    </label>
                    <input type="range" id="input-qcount" min="5" max="50" step="5" value="10" oninput="updateSettingsPreview()" class="w-full accent-purple-500 cursor-pointer">
                    <div class="flex justify-between text-[10px] text-purple-400 mt-1">
                        <span>5題 (快速)</span>
                        <span>25題</span>
                        <span>50題 (挑戰)</span>
                    </div>
                </div>

                <!-- 難度設定 (1~10級) -->
                <div>
                    <label class="block font-bold text-purple-700 mb-1 flex justify-between items-center">
                        <span>⭐ 挑戰難度級別：</span>
                        <span id="lbl-diff" class="bg-purple-200 text-purple-800 px-2 py-0.5 rounded-md text-xs">Lv. 1</span>
                    </label>
                    <input type="range" id="input-diff" min="1" max="10" step="1" value="1" oninput="updateSettingsPreview()" class="w-full accent-purple-500 cursor-pointer">
                    <div class="flex justify-between text-[10px] text-purple-400 mt-1">
                        <span>Lv.1 (初階)</span>
                        <span>Lv.5 (進階)</span>
                        <span>Lv.10 (大師)</span>
                    </div>
                </div>
            </div>

            <button onclick="saveSettings()" class="w-full bg-purple-500 hover:bg-purple-600 text-white font-bold py-2.5 rounded-xl text-sm pulse-btn shadow-md">
                儲存設定並返回
            </button>
        </div>

        <!-- 畫面 4：寵物換裝商店 -->
        <div id="screen-shop" class="flex flex-col items-center hidden">
            <h2 class="text-lg font-bold text-amber-600 mb-2">👑 吉祥物換裝商店</h2>
            <div class="text-xs text-amber-700 bg-amber-50 p-2 rounded-xl mb-3 text-center border border-amber-200 w-full">
                目前金幣：🪙 <span id="shop-coin">0</span> ｜ 累積星星：⭐ <span id="shop-star">0</span>
            </div>

            <div class="w-full flex flex-col gap-2.5 max-h-64 overflow-y-auto pr-1 mb-3" id="shop-items-container">
                <!-- 動態商店商品 -->
            </div>

            <button onclick="goHome()" class="w-full bg-slate-200 hover:bg-slate-300 text-slate-600 font-bold py-2.5 rounded-xl text-sm pulse-btn">
                返回主選單
            </button>
        </div>

        <!-- 畫面 5：答題進行中 -->
        <div id="screen-game" class="flex flex-col items-center hidden">
            <!-- 進度與小Q提示 -->
            <div class="w-full flex justify-between items-center mb-2">
                <span id="q-progress" class="bg-pink-100 text-pink-600 font-bold text-xs px-2.5 py-1 rounded-full">第 1 題 / 共 10 題</span>
                <span id="q-helper-msg" class="text-xs text-pink-500 font-bold bg-pink-50 px-2 py-1 rounded-lg border border-pink-100">小Q：加油！你可以的！</span>
            </div>

            <!-- 進度條 -->
            <div class="w-full bg-pink-100 h-2 rounded-full mb-3 overflow-hidden">
                <div id="progress-bar" class="bg-gradient-to-r from-pink-400 to-rose-400 h-full w-0 transition-all duration-300"></div>
            </div>

            <!-- 題目卡片 (加入 box-border 確保直式排版不出界) -->
            <div class="w-full bg-pink-50/50 border-2 border-pink-200 rounded-2xl p-4 mb-4 flex flex-col items-center box-border shadow-sm">
                <div id="question-text" class="text-base sm:text-lg font-bold text-slate-700 text-center mb-4 leading-relaxed tracking-wide px-1 break-words w-full">
                    載入中...
                </div>

                <!-- 輸入區或選項區 -->
                <div id="answer-area" class="w-full flex flex-col gap-2.5 items-center">
                    <input type="number" id="user-input" placeholder="請輸入答案" class="w-full max-w-xs text-center text-lg font-bold py-2.5 px-3 border-2 border-pink-300 rounded-xl focus:outline-none focus:border-pink-500 bg-white box-border shadow-inner" onkeydown="if(event.key==='Enter') submitAnswer()">
                    <button onclick="submitAnswer()" class="w-full max-w-xs bg-pink-500 hover:bg-pink-600 text-white font-bold py-2.5 rounded-xl shadow-md pulse-btn text-base">
                        確定送出 🎯
                    </button>
                </div>
            </div>
        </div>

        <!-- 畫面 6：結算畫面 -->
        <div id="screen-result" class="flex flex-col items-center text-center hidden">
            <div class="text-5xl mb-2 bouncy">🏆</div>
            <h2 class="text-xl font-black text-pink-500 mb-1">闖關成功！</h2>
            <p class="text-xs text-slate-400 mb-4">太棒了！你順利完成新思維數學挑戰！</p>

            <div class="w-full bg-pink-50 border-2 border-pink-200 rounded-2xl p-4 mb-4 flex flex-col gap-2 text-sm">
                <div class="flex justify-between items-center font-bold">
                    <span>正確題數：</span>
                    <span id="res-correct" class="text-pink-600">8 / 10</span>
                </div>
                <div class="flex justify-between items-center font-bold">
                    <span>獲得星星：</span>
                    <span id="res-star" class="text-amber-600">+8 ⭐</span>
                </div>
                <div class="flex justify-between items-center font-bold">
                    <span>獲得金幣：</span>
                    <span id="res-coin" class="text-amber-500">+40 🪙</span>
                </div>
            </div>

            <div class="w-full flex gap-2">
                <button onclick="restartGame()" class="flex-1 bg-pink-500 hover:bg-pink-600 text-white font-bold py-2.5 rounded-xl text-sm pulse-btn shadow-md">
                    再玩一次 🔄
                </button>
                <button onclick="goHome()" class="flex-1 bg-slate-200 hover:bg-slate-300 text-slate-600 font-bold py-2.5 rounded-xl text-sm pulse-btn">
                    回主選單 🏠
                </button>
            </div>
        </div>

    </div>

    <!-- 自訂提示 Modal / 訊息 -->
    <div id="custom-modal" class="fixed inset-0 bg-black/40 backdrop-blur-sm flex items-center justify-center p-4 hidden z-50">
        <div class="bg-white rounded-3xl p-5 max-w-xs w-full text-center border-4 border-pink-200 shadow-2xl bouncy">
            <div id="modal-icon" class="text-4xl mb-2">🎉</div>
            <h3 id="modal-title" class="text-lg font-black text-pink-500 mb-1">答對了！</h3>
            <p id="modal-desc" class="text-xs text-slate-600 mb-4">你真聰明！獲得 1 顆星星與 5 枚金幣！</p>
            <button onclick="closeModal()" class="w-full bg-pink-500 hover:bg-pink-600 text-white font-bold py-2 rounded-xl text-sm shadow-md pulse-btn">
                繼續挑戰 🚀
            </button>
        </div>
    </div>

    <script>
        // 遊戲狀態與存檔
        let gameState = {
            stars: parseInt(localStorage.getItem('math_stars')) || 0,
            coins: parseInt(localStorage.getItem('math_coins')) || 0,
            qCount: parseInt(localStorage.getItem('math_qcount')) || 10,
            difficulty: parseInt(localStorage.getItem('math_diff')) || 1,
            unlockedAccessories: JSON.parse(localStorage.getItem('math_accessories')) || ['default'],
            equippedAccessory: localStorage.getItem('math_equipped') || 'default'
        };

        // 目前遊戲對戰變數
        let currentGrade = 1;
        let currentUnitId = '';
        let currentQuestions = [];
        let currentIndex = 0;
        let correctCount = 0;
        let currentCorrectAnswer = null;

        // 教育出版社《小學數學新思維》課程架構定義
        const curriculum = {
            1: [
                { id: 'g1_1', name: '1校園數數與20以內數' },
                { id: 'g1_2', name: '2加法認識與基本運算' },
                { id: 'g1_3', name: '3減法認識與退位前計算' },
                { id: 'g1_4', name: '4物件分類與位置方向' },
                { id: 'g1_5', name: '5生活文字應用題 (新思維)' }
            ],
            2: [
                { id: 'g2_1', name: '1 100以內加減混合計算' },
                { id: 'g2_2', name: '2 九九乘法與除法初探' },
                { id: 'g2_3', name: '3 香港硬幣與找續應用' },
                { id: 'g2_4', name: '4 方向與簡單平面圖形' },
                { id: 'g2_5', name: '5 生活文字應用題 (新思維)' }
            ],
            3: [
                { id: 'g3_1', name: '1 千以內數與四則混合' },
                { id: 'g3_2', name: '2 分數概念與同分母加減' },
                { id: 'g3_3', name: '3 周界計算與長度換算' },
                { id: 'g3_4', name: '4 時間與秒的認識' },
                { id: 'g3_5', name: '5 生活文字應用題 (新思維)' }
            ]
        };

        // 寵物商店商品
        const shopItems = [
            { id: 'default', name: '可愛貓頭鷹小Q', cost: 0, icon: '🦉' },
            { id: 'crown', name: '尊貴小皇冠', cost: 30, icon: '👑' },
            { id: 'bow', name: '粉紅蝴蝶結', cost: 50, icon: '🎀' },
            { id: 'sunglasses', name: '帥氣太陽眼鏡', cost: 80, icon: '🕶️' }
        ];

        // Web Audio API 音效合成器 (免外部音訊檔)
        let audioCtx = null;
        function initAudio() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
        }

        function playSound(type) {
            try {
                initAudio();
                if (audioCtx.state === 'suspended') {
                    audioCtx.resume();
                }
                const now = audioCtx.currentTime;
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.connect(gain);
                gain.connect(audioCtx.destination);

                if (type === 'correct') {
                    // 輕鬆愉快的答對旋律 (Do-Mi-Sol)
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(523.25, now); // C5
                    osc.frequency.setValueAtTime(659.25, now + 0.1); // E5
                    osc.frequency.setValueAtTime(783.99, now + 0.2); // G5
                    gain.gain.setValueAtTime(0.15, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.4);
                    osc.start(now);
                    osc.stop(now + 0.4);
                } else {
                    // 不開心/提示音效 (低音下沉)
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(220, now); // A3
                    osc.frequency.setValueAtTime(180, now + 0.15); // F3
                    gain.gain.setValueAtTime(0.15, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.35);
                    osc.start(now);
                    osc.stop(now + 0.35);
                }
            } catch (e) {
                console.log('Audio error:', e);
            }
        }

        // 初始化更新 UI
        function updateTopBar() {
            document.getElementById('star-count').innerText = gameState.stars;
            document.getElementById('coin-count').innerText = gameState.coins;
            document.getElementById('display-diff').innerText = `⭐ 難度 Lv.${gameState.difficulty}`;
        }

        function goHome() {
            hideAllScreens();
            document.getElementById('screen-home').classList.remove('hidden');
            document.getElementById('top-bar').classList.remove('hidden');
            updateTopBar();
        }

        function hideAllScreens() {
            const screens = ['screen-home', 'screen-grade', 'screen-settings', 'screen-shop', 'screen-game', 'screen-result'];
            screens.forEach(s => document.getElementById(s).classList.add('hidden'));
        }

        // 年級與單元選擇
        function openGradeSelect() {
            hideAllScreens();
            document.getElementById('screen-grade').classList.remove('hidden');
            switchGradeTab(1);
        }

        function switchGradeTab(grade) {
            currentGrade = grade;
            for (let i = 1; i <= 3; i++) {
                const btn = document.getElementById(`tab-g3_${i}` || `tab-g${i}`);
                if (btn) {
                    if (i === grade) {
                        btn.className = "flex-1 py-1.5 text-xs font-bold rounded-xl bg-white text-pink-600 shadow-sm transition";
                    } else {
                        btn.className = "flex-1 py-1.5 text-xs font-bold rounded-xl text-slate-500 transition";
                    }
                }
            }
            // 渲染單元
            const listEl = document.getElementById('unit-list');
            listEl.innerHTML = '';
            curriculum[grade].forEach(unit => {
                const uBtn = document.createElement('button');
                uBtn.className = "w-full bg-pink-50 hover:bg-pink-100 border-2 border-pink-200 text-pink-700 font-bold p-3 rounded-2xl flex justify-between items-center transition pulse-btn text-xs sm:text-sm";
                uBtn.innerHTML = `<span>📖 ${unit.name}</span><span>👉 開始</span>`;
                uBtn.onclick = () => startUnitGame(unit.id);
                listEl.appendChild(uBtn);
            });
        }

        // 設定選單
        function openSettings() {
            hideAllScreens();
            document.getElementById('screen-settings').classList.remove('hidden');
            document.getElementById('input-qcount').value = gameState.qCount;
            document.getElementById('input-diff').value = gameState.difficulty;
            updateSettingsPreview();
        }

        function updateSettingsPreview() {
            const q = document.getElementById('input-qcount').value;
            const d = document.getElementById('input-diff').value;
            document.getElementById('lbl-qcount').innerText = `${q} 題`;
            document.getElementById('lbl-diff').innerText = `Lv. ${d}`;
        }

        function saveSettings() {
            gameState.qCount = parseInt(document.getElementById('input-qcount').value);
            gameState.difficulty = parseInt(document.getElementById('input-diff').value);
            localStorage.setItem('math_qcount', gameState.qCount);
            localStorage.setItem('math_diff', gameState.difficulty);
            updateTopBar();
            goHome();
        }

        // 商店選單
        function openShop() {
            hideAllScreens();
            document.getElementById('screen-shop').classList.remove('hidden');
            document.getElementById('shop-coin').innerText = gameState.coins;
            document.getElementById('shop-star').innerText = gameState.stars;
            
            const container = document.getElementById('shop-items-container');
            container.innerHTML = '';
            shopItems.forEach(item => {
                const isUnlocked = gameState.unlockedAccessories.includes(item.id);
                const isEquipped = gameState.equippedAccessory === item.id;
                
                const div = document.createElement('div');
                div.className = "bg-amber-50/70 border-2 border-amber-200 rounded-2xl p-3 flex justify-between items-center text-xs";
                div.innerHTML = `
                    <div class="flex items-center gap-2">
                        <span class="text-2xl">${item.icon}</span>
                        <div>
                            <div class="font-bold text-amber-900">${item.name}</div>
                            <div class="text-[10px] text-amber-600">${item.cost === 0 ? '免費預設' : `價格：🪙 ${item.cost}`}</div>
                        </div>
                    </div>
                    <div>
                        ${isEquipped ? '<span class="bg-green-100 text-green-700 font-bold px-2.5 py-1 rounded-xl">已裝備</span>' : 
                          isUnlocked ? `<button onclick="equipItem('${item.id}')" class="bg-amber-400 hover:bg-amber-500 text-white font-bold px-3 py-1 rounded-xl shadow-sm">裝備</button>` :
                          `<button onclick="buyItem('${item.id}',${item.cost})" class="bg-orange-500 hover:bg-orange-600 text-white font-bold px-3 py-1 rounded-xl shadow-sm">解鎖</button>`}
                    </div>
                `;
                container.appendChild(div);
            });
        }

        function buyItem(id, cost) {
            if (gameState.coins >= cost) {
                gameState.coins -= cost;
                gameState.unlockedAccessories.push(id);
                gameState.equippedAccessory = id;
                localStorage.setItem('math_coins', gameState.coins);
                localStorage.setItem('math_accessories', JSON.stringify(gameState.unlockedAccessories));
                localStorage.setItem('math_equipped', gameState.equippedAccessory);
                openShop();
                updateTopBar();
            } else {
                showModal('🪙', '金幣不足', '多完成幾題數學練習就能賺取更多金幣喔！');
            }
        }

        function equipItem(id) {
            gameState.equippedAccessory = id;
            localStorage.setItem('math_equipped', id);
            openShop();
        }

        // 根據新思維課程與難度動態生成題庫
        function startUnitGame(unitId) {
            currentUnitId = unitId;
            currentQuestions = generateQuestions(unitId, gameState.qCount, gameState.difficulty);
            currentIndex = 0;
            correctCount = 0;

            hideAllScreens();
            document.getElementById('screen-game').classList.remove('hidden');
            loadQuestion();
        }

        function generateQuestions(unitId, count, diff) {
            let questions = [];
            let maxVal = diff * 5 + 10; // 難度影響數值大小

            for (let i = 0; i < count; i++) {
                let qText = "";
                let ans = 0;

                if (unitId === 'g1_1') {
                    // 一年級：數數與20以內
                    let a = Math.floor(Math.random() * maxVal) + 1;
                    let b = Math.floor(Math.random() * maxVal) + 1;
                    qText = `小華有 ${a} 個蘋果，媽媽又買了 ${b} 個，現在一共有幾個蘋果？`;
                    ans = a + b;
                } else if (unitId === 'g1_2') {
                    let a = Math.floor(Math.random() * maxVal) + 2;
                    let b = Math.floor(Math.random() * (a - 1)) + 1;
                    qText = `桌上有 ${a} 本作業本，分給同學 ${b} 本後，還剩下幾本？`;
                    ans = a - b;
                } else if (unitId === 'g1_3' || unitId === 'g1_4' || unitId === 'g1_5') {
                    let a = Math.floor(Math.random() * maxVal) + 3;
                    let b = Math.floor(Math.random() * maxVal) + 2;
                    let c = Math.floor(Math.random() * 5) + 1;
                    qText = `小明收集了 ${a} 張貼紙，小美送他 ${b} 張，他又貼在簿子上 ${c} 張。請問現在還剩幾張？`;
                    ans = a + b - c;
                } else if (unitId === 'g2_1') {
                    let a = Math.floor(Math.random() * (diff * 10)) + 10;
                    let b = Math.floor(Math.random() * 10) + 5;
                    let c = Math.floor(Math.random() * 10) + 1;
                    qText = `計算： ${a} + ${b} - ${c} = ?`;
                    ans = a + b - c;
                } else if (unitId === 'g2_2') {
                    let a = Math.floor(Math.random() * 9) + 2;
                    let b = Math.floor(Math.random() * 9) + 2;
                    qText = `根據九九乘法： ${a} × ${b} = ?`;
                    ans = a * b;
                } else if (unitId === 'g2_3' || unitId === 'g2_4' || unitId === 'g2_5') {
                    let price = Math.floor(Math.random() * (diff * 8)) + 10;
                    let pay = price + Math.floor(Math.random() * 20) + 5;
                    qText = `文具店裡一本筆記本售價 ${price} 元。小文付了 ${50} 元紙幣，應找回多少元？`;
                    ans = 50 - price;
                } else if (unitId === 'g3_1') {
                    let a = Math.floor(Math.random() * (diff * 30)) + 50;
                    let b = Math.floor(Math.random() * 30) + 10;
                    qText = `圖書館原有圖書 ${a} 本，新買進 ${b} 本後，圖書館共有多少本圖書？`;
                    ans = a + b;
                } else if (unitId === 'g3_2') {
                    let denom = Math.floor(Math.random() * 4) + 4; // 分母 4~8
                    let num1 = Math.floor(Math.random() * (denom - 2)) + 1;
                    let num2 = Math.floor(Math.random() * (denom - num1 - 1)) + 1;
                    qText = `一個餅分成了 ${denom} 等分。哥哥吃了其中的 ${num1} 份，弟弟吃了 ${num2} 份。兩人一共吃了幾分之幾？(請直接輸入分子數字)`;
                    ans = num1 + num2;
                } else {
                    let length1 = Math.floor(Math.random() * (diff * 15)) + 10;
                    let length2 = Math.floor(Math.random() * 20) + 5;
                    qText = `一條絲帶長 ${length1} 公分，另一條長 ${length2} 公分，兩條絲帶接起來共長多少公分？`;
                    ans = length1 + length2;
                }

                questions.push({ qText, ans });
            }
            return questions;
        }

        function loadQuestion() {
            if (currentIndex >= currentQuestions.length) {
                showResult();
                return;
            }

            const q = currentQuestions[currentIndex];
            currentCorrectAnswer = q.ans;

            document.getElementById('q-progress').innerText = `第 ${currentIndex + 1} 題 / 共 ${currentQuestions.length} 題`;
            document.getElementById('question-text').innerText = q.qText;
            document.getElementById('user-input').value = '';
            
            // 進度條
            const percent = ((currentIndex) / currentQuestions.length) * 100;
            document.getElementById('progress-bar').style.width = `${percent}%`;

            // 小Q隨機提示
            const helpers = ["小Q：仔細讀題唷！", "小Q：動動腦筋，答案就在其中！", "小Q：加油，你可以算出正確答案的！"];
            document.getElementById('q-helper-msg').innerText = helpers[Math.floor(Math.random() * helpers.length)];

            setTimeout(() => {
                document.getElementById('user-input').focus();
            }, 100);
        }

        function submitAnswer() {
            const val = document.getElementById('user-input').value.trim();
            if (val === '') return;

            const userAns = parseFloat(val);
            if (userAns === currentCorrectAnswer) {
                correctCount++;
                playSound('correct');
                showModal('🎉', '答對了！真聰明！', '獲得 +1 顆星星與 +5 枚金幣！');
                gameState.stars += 1;
                gameState.coins += 5;
            } else {
                playSound('wrong');
                showModal('💪', '沒關係，再接再厲！', `正確答案是：${currentCorrectAnswer}`);
            }

            localStorage.setItem('math_stars', gameState.stars);
            localStorage.setItem('math_coins', gameState.coins);
            updateTopBar();

            currentIndex++;
        }

        function closeModal() {
            document.getElementById('custom-modal').classList.add('hidden');
            if (currentIndex < currentQuestions.length) {
                loadQuestion();
            } else {
                showResult();
            }
        }

        function showModal(icon, title, desc) {
            document.getElementById('modal-icon').innerText = icon;
            document.getElementById('modal-title').innerText = title;
            document.getElementById('modal-desc').innerText = desc;
            document.getElementById('custom-modal').classList.remove('hidden');
        }

        function showResult() {
            hideAllScreens();
            document.getElementById('screen-result').classList.remove('hidden');
            document.getElementById('res-correct').innerText = `${correctCount} / ${currentQuestions.length}`;
            document.getElementById('res-star').innerText = `+${correctCount} ⭐`;
            document.getElementById('res-coin').innerText = `+${correctCount * 5} 🪙`;
        }

        function restartGame() {
            startUnitGame(currentUnitId);
        }

        // 初始化載入
        goHome();
    </script>
</body>
</html>
